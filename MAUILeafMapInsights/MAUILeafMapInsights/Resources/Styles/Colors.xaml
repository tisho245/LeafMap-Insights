<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Палитра като сайта (styles.css) -->
    <Color x:Key="Primary">#1F7A4D</Color>
    <Color x:Key="Accent2">#7BD389</Color>
    <Color x:Key="Accent3">#0AA06E</Color>
    <Color x:Key="PrimaryDark">#1E6B45</Color>
    <Color x:Key="PrimaryDarkText">#0B1F14</Color>

    <Color x:Key="Secondary">#E8F5EE</Color>
    <Color x:Key="SecondaryDarkText">#1E6B45</Color>
    <Color x:Key="Tertiary">#0B1F14</Color>

    <!-- Фон като сайта: bg #f7fbf7, bg-2 #eef6ef -->
    <Color x:Key="Background">#F7FBF7</Color>
    <Color x:Key="Background2">#EEF6EF</Color>
    <Color x:Key="BackgroundTop">#FAFCFB</Color>
    <Color x:Key="BackgroundBottom">#EEF2F0</Color>

    <!-- Карти/повърхности: бяло с лека прозрачност като hero-card -->
    <Color x:Key="Surface">#FFFFFF</Color>
    <Color x:Key="SurfaceAlt">#F0F7F2</Color>

    <!-- Текст: text #0b1f14, muted #5f776a -->
    <Color x:Key="Text">#0B1F14</Color>
    <Color x:Key="Muted">#5F776A</Color>
    <Color x:Key="Border">#D8E4DC</Color>

    <Color x:Key="Success">#1B8B54</Color>
    <Color x:Key="Error">#C23C3C</Color>

    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#0B1F14</Color>
    <Color x:Key="OffBlack">#0B1F14</Color>

    <Color x:Key="Gray100">#EEF4F0</Color>
    <Color x:Key="Gray200">#DCE4E0</Color>
    <Color x:Key="Gray300">#B8C9C1</Color>
    <Color x:Key="Gray400">#8FA399</Color>
    <Color x:Key="Gray500">#5F756B</Color>
    <Color x:Key="Gray600">#3D5249</Color>
    <Color x:Key="Gray900">#243830</Color>
    <Color x:Key="Gray950">#1A2E24</Color>
    <Color x:Key="MidnightBlue">#0B1F14</Color>
    <Color x:Key="Magenta">#1F7A4D</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}" />
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}" />
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}" />
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource Background}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Surface}" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAlt}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource Text}" />
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource Muted}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource Border}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource Success}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource Error}" />
</ResourceDictionary>
