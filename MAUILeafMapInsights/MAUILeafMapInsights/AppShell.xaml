<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MAUILeafMapInsights.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:MAUILeafMapInsights.Pages"
    Shell.FlyoutBehavior="Flyout"
    Title="LeafMap Insights">

    <FlyoutItem Title="Начало" Icon="dotnet_bot.png">
        <ShellContent Route="Home" ContentTemplate="{DataTemplate pages:HomePage}" />
    </FlyoutItem>
    <FlyoutItem Title="Дървета" Icon="dotnet_bot.png">
        <ShellContent Route="Trees" ContentTemplate="{DataTemplate pages:TreesPage}" />
    </FlyoutItem>
    <FlyoutItem Title="Карта" Icon="dotnet_bot.png">
        <ShellContent Route="Map" ContentTemplate="{DataTemplate pages:MapPage}" />
    </FlyoutItem>
    <FlyoutItem Title="Таксономия" Icon="dotnet_bot.png">
        <ShellContent Route="Taxonomy" ContentTemplate="{DataTemplate pages:TaxonomyPage}" />
    </FlyoutItem>
    <FlyoutItem x:Name="AuthFlyoutItem" Title="Вход" Icon="dotnet_bot.png">
        <ShellContent Route="Login" ContentTemplate="{DataTemplate pages:LoginPage}" />
    </FlyoutItem>

    <ShellContent Route="Register" ContentTemplate="{DataTemplate pages:RegisterPage}" />
    <ShellContent Route="AddTree" ContentTemplate="{DataTemplate pages:AddTreePage}" />
    <ShellContent Route="TreeDetail" ContentTemplate="{DataTemplate pages:TreeDetailPage}" />
</Shell>
