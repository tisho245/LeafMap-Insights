<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net9.0-android;net9.0-ios;net9.0-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net9.0-windows10.0.19041.0</TargetFrameworks>
		<!-- Uncomment to also build the tizen app. You will need to install tizen by following this: https://github.com/Samsung/Tizen.NET -->
		<!-- <TargetFrameworks>$(TargetFrameworks);net9.0-tizen</TargetFrameworks> -->

		<!-- Note for MacCatalyst:
		The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
		When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
		The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
		either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
		<!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

		<OutputType>Exe</OutputType>
		<RootNamespace>MAUILeafMapInsights</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Display name -->
		<ApplicationTitle>MAUILeafMapInsights</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.companyname.mauileafmapinsights</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
		<WindowsPackageType>None</WindowsPackageType>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'tizen'">6.5</SupportedOSPlatformVersion>

		<!-- Изключване на Fast Deployment за Android – избягва XA0129 при deploy на някои устройства/емулатори -->
		<EmbedAssembliesIntoApk Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">true</EmbedAssembliesIntoApk>

		<!-- Android: фон на иконката да е светъл (PNG с прозрачност иначе става черен) -->
		<AndroidIconBackgroundColor Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">#F7FBF7</AndroidIconBackgroundColor>

		<!-- Винаги изход APK (не AAB) и подписан за инсталиране на телефон; Release използва debug keystore ако няма свой -->
		<AndroidPackageFormat Condition="'$(TargetFramework)' == 'net9.0-android'">apk</AndroidPackageFormat>
		<AndroidSigningKeyStore Condition="'$(TargetFramework)' == 'net9.0-android' and '$(Configuration)' == 'Release' and '$(AndroidSigningKeyStore)' == ''">$(USERPROFILE)\.android\debug.keystore</AndroidSigningKeyStore>
		<AndroidSigningKeyStorePassword Condition="'$(TargetFramework)' == 'net9.0-android' and '$(Configuration)' == 'Release' and '$(AndroidSigningKeyStore)' == ''">android</AndroidSigningKeyStorePassword>
		<AndroidSigningKeyAlias Condition="'$(TargetFramework)' == 'net9.0-android' and '$(Configuration)' == 'Release' and '$(AndroidSigningKeyStore)' == ''">androiddebugkey</AndroidSigningKeyAlias>
		<AndroidSigningKeyPass Condition="'$(TargetFramework)' == 'net9.0-android' and '$(Configuration)' == 'Release' and '$(AndroidSigningKeyStore)' == ''">android</AndroidSigningKeyPass>
		<AndroidSigningStorePass Condition="'$(TargetFramework)' == 'net9.0-android' and '$(Configuration)' == 'Release' and '$(AndroidSigningKeyStore)' == ''">android</AndroidSigningStorePass>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon – логото (appicon.png в AppIcon; името appicon да съвпада с AndroidManifest @mipmap/appicon) -->
		<MauiIcon Include="Resources\AppIcon\appicon.png" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />

		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="9.0.0" />
		<PackageReference Include="Microsoft.Extensions.Http" Version="9.0.0" />
	</ItemGroup>

	<ItemGroup>
	  <MauiXaml Update="Resources\Styles\LeafMapTheme.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	</ItemGroup>

	<!-- При всеки Android билд копирай APK в папка APK за лесно тестване на телефон -->
	<Target Name="CopyApkForDevice" AfterTargets="Build" Condition="'$(TargetFramework)' == 'net9.0-android'">
		<PropertyGroup>
			<_ApkDir>$(MSBuildProjectDirectory)\APK</_ApkDir>
			<_DestApk>$(_ApkDir)\LeafMapInsights-$(Configuration).apk</_DestApk>
		</PropertyGroup>
		<MakeDir Directories="$(_ApkDir)" Condition="!Exists('$(_ApkDir)')" />
		<Copy SourceFiles="$(OutputPath)$(ApplicationId)-Signed.apk" DestinationFiles="$(_DestApk)" Condition="Exists('$(OutputPath)$(ApplicationId)-Signed.apk')" SkipUnchangedFiles="true" />
		<Copy SourceFiles="$(OutputPath)$(ApplicationId).apk" DestinationFiles="$(_DestApk)" Condition="!Exists('$(OutputPath)$(ApplicationId)-Signed.apk') and Exists('$(OutputPath)$(ApplicationId).apk')" SkipUnchangedFiles="true" />
		<Message Importance="high" Text="APK за телефон: $(_DestApk)" />
	</Target>

</Project>
