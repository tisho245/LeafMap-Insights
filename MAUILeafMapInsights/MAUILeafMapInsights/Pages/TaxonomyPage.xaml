<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MAUILeafMapInsights.Pages.TaxonomyPage"
             Title="Таксономия">

    <Grid RowDefinitions="Auto,*">
        <VerticalStackLayout Grid.Row="0" Padding="20,16,20,8" Spacing="4">
            <Label Text="Таксономия" StyleClass="PageTitle" />
            <Label Text="Преглед на йерархията: отдел → клас → семейство → род → вид."
                   StyleClass="PageSubtitle" />
        </VerticalStackLayout>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout x:Name="TaxonomyStack" Padding="16,0,16,24" Spacing="16" />
        </ScrollView>
    </Grid>
</ContentPage>
