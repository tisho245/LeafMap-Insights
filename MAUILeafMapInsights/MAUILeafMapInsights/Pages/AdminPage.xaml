<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MAUILeafMapInsights.Pages.AdminPage"
             Title="Админ – Потребители">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="12">
            <Label x:Name="TitleLabel" Text="Потребители" FontSize="20" FontAttributes="FontAttributes.Bold" />
            <Label x:Name="LoadingLabel" Text="Зареждане..." IsVisible="True" />
            <CollectionView x:Name="UsersList" IsVisible="False" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Padding="12" Margin="0,4" HasShadow="False">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding Email}" FontAttributes="Bold" />
                                <Label Text="{Binding RolesDisplay}" TextColor="Gray" FontSize="12" />
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <Label x:Name="ErrorLabel" Text="" TextColor="Red" IsVisible="False" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
