<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pages="clr-namespace:MAUILeafMapInsights.Pages"
             x:Class="MAUILeafMapInsights.Pages.AdminPage"
             Title="Админ">

    <Grid RowDefinitions="Auto,Auto,*">
        <VerticalStackLayout Grid.Row="0" Padding="20,16" Spacing="8">
            <Label Text="Админ – CRUD" StyleClass="PageTitle" TextColor="{StaticResource Text}" />
            <Label Text="Потребители, дървета и таксономия. Избери секция по-долу." StyleClass="PageSubtitle" TextColor="{StaticResource Muted}" />
            <Picker x:Name="SectionPicker" Title="Секция" SelectedIndexChanged="OnSectionChanged"
                    TextColor="{StaticResource Text}" BackgroundColor="{StaticResource Surface}" />
        </VerticalStackLayout>

        <HorizontalStackLayout Grid.Row="1" Padding="20,0" Spacing="8" HorizontalOptions="End">
            <Button x:Name="AddButton" Text="Добави" Clicked="OnAddClicked" StyleClass="PrimaryButton" IsVisible="False" />
        </HorizontalStackLayout>

        <Border Grid.Row="2" StyleClass="Card" Margin="20,8,20,24" Padding="12">
            <Grid>
                <RefreshView x:Name="RefreshView" Refreshing="OnRefreshing">
                    <ScrollView>
                        <VerticalStackLayout x:Name="ListStack" Spacing="8" Padding="4" />
                    </ScrollView>
                </RefreshView>
                <Label x:Name="LoadingLabel" Text="Зареждане..." IsVisible="False" TextColor="{StaticResource Muted}"
                       HorizontalOptions="Center" VerticalOptions="Center" />
                <Label x:Name="ErrorLabel" Text="" TextColor="{StaticResource Error}" IsVisible="False"
                       HorizontalOptions="Center" VerticalOptions="Center" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>
