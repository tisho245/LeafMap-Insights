<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MAUILeafMapInsights.Pages.MapPage"
             Title="Карта">
    <Grid RowDefinitions="Auto,*">
        <Button x:Name="RefreshButton" Grid.Row="0" Text="Обнови" Clicked="OnRefreshClicked" HorizontalOptions="Start" Margin="8" />
        <ContentView x:Name="MapContainer" Grid.Row="1" />
        <ActivityIndicator x:Name="Loading" Grid.RowSpan="2" IsRunning="False" IsVisible="False" Color="{StaticResource Primary}" />
    </Grid>
</ContentPage>
