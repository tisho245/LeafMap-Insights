<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:MAUILeafMapInsights.Models"
             x:Class="MAUILeafMapInsights.Pages.TreesPage"
             Title="Дървета">
    <Grid RowDefinitions="Auto,*">
        <Button Grid.Row="0" Text="Обнови" Clicked="OnRefreshClicked" HorizontalOptions="Start" Margin="8" />
        <RefreshView Grid.Row="1" x:Name="RefreshView" Refreshing="OnRefreshing">
            <CollectionView x:Name="TreeList" SelectionMode="Single" SelectionChanged="OnTreeSelected">
                <CollectionView.EmptyView>
                    <Label Text="Няма дървета или грешка при зареждане. Проверете API URL и дали API-то работи." Margin="20" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:TreeDto">
                        <Grid Padding="12,8" ColumnDefinitions="*,Auto">
                            <VerticalStackLayout>
                                <Label Text="{Binding Name}" FontAttributes="Bold" />
                                <Label Text="{Binding Species.Name, StringFormat='Вид: {0}'}" FontSize="Small" TextColor="Gray" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="{Binding Id, StringFormat='#{0}'}" VerticalOptions="Center" TextColor="Gray" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
        <ActivityIndicator x:Name="Loading" Grid.RowSpan="2" IsRunning="False" IsVisible="False" Color="{StaticResource Primary}" />
    </Grid>
</ContentPage>
