@model ErrorViewModel
@{
    ViewData["Title"] = "Грешка";
}

<div class="container-fluid fade-in">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-lg border-0 mt-5">
                <div class="card-body text-center p-5">
                    <span class="icon-large text-danger">⚠️</span>
                    <h1 class="text-danger mb-3">Възникна грешка</h1>
                    <p class="lead text-muted mb-4">Нещо се обърка при обработката на вашата заявка.</p>

                    @if (Model.ShowRequestId)
                    {
                        <div class="alert alert-info">
                            <strong>ID на заявка:</strong> <code>@Model.RequestId</code>
                        </div>
                    }

                    <div class="mt-4">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-lg">
                            <span>🏠</span> Начало
                        </a>
                        <a href="javascript:history.back()" class="btn btn-secondary btn-lg">
                            <span>←</span> Назад
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
