@model IEnumerable<LeafMap_Insights.Models.Genus>

@{
    ViewData["Title"] = "Manage Genera";
}

<div class="container-fluid fade-in">
    <div class="page-header">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h1><span>🔬</span> Управление на родове</h1>
                <p class="lead">Управление на ботанически родове</p>
            </div>
            <a asp-action="CreateGenus" class="btn btn-light btn-lg">
                <span>➕</span> Добави нов род
            </a>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Име</th>
                        <th>Латинско име</th>
                        <th>Семейство</th>
                        <th>Описание</th>
                        <th>Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td>@item.Name</td>
                            <td><em>@item.LatinName</em></td>
                            <td>@item.Family?.Name</td>
                            <td>@(item.Description ?? "-")</td>
                            <td>
                                <a asp-action="EditGenus" asp-route-id="@item.Id" class="btn btn-sm btn-warning">
                                    <span>✏️</span> Редактирай
                                </a>
                                <a asp-action="DeleteGenus" asp-route-id="@item.Id" class="btn btn-sm btn-danger">
                                    <span>🗑️</span> Изтрий
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            Няма намерени родове. <a asp-action="CreateGenus" class="alert-link">Създайте първия род</a>
        </div>
    }
</div>
