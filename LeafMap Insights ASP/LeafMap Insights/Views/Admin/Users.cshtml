@model IEnumerable<LeafMap_Insights.Models.ViewModels.UserViewModel>

@{
    ViewData["Title"] = "Управление на потребители";
}

<div class="container-fluid fade-in">
    <div class="page-header">
        <div>
            <h1><span>👤</span> Управление на потребители</h1>
            <p class="lead">Управление на потребители и роли</p>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Имейл</th>
                        <th>Потребителско име</th>
                        <th>Имейл потвърден</th>
                        <th>Роли</th>
                        <th>Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td>@user.Email</td>
                            <td>@user.UserName</td>
                            <td>
                                @if (user.EmailConfirmed)
                                {
                                    <span class="badge bg-success">Да</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning">Не</span>
                                }
                            </td>
                            <td>
                                @foreach (var role in user.Roles)
                                {
                                    <span class="badge bg-primary me-1">@role</span>
                                }
                                @if (!user.Roles.Any())
                                {
                                    <span class="text-muted">Няма роли</span>
                                }
                            </td>
                            <td>
                                <div class="btn-group" role="group">
                                    <a asp-action="EditUser" asp-route-id="@user.Id" class="btn btn-sm btn-warning">
                                        <span>✏️</span> Редактирай
                                    </a>
                                    <a asp-action="DeleteUser" asp-route-id="@user.Id" class="btn btn-sm btn-danger">
                                        <span>🗑️</span> Изтрий
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            Няма намерени потребители.
        </div>
    }
</div>
