@model IEnumerable<LeafMap_Insights.Models.Tree>

@{
    ViewData["Title"] = "Управление на дървета";
}

<div class="container-fluid fade-in">
    <div class="page-header">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h1><span>🌲</span> Управление на дървета</h1>
                <p class="lead">Добавяне, редактиране или изтриване на дървета в базата данни</p>
            </div>
            <a asp-action="CreateTree" class="btn btn-light btn-lg">
                <span>➕</span> Добави ново дърво
            </a>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Вид</th>
                        <th>Местоположение</th>
                        <th>Възраст</th>
                        <th>Височина</th>
                        <th>Състояние</th>
                        <th>Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td>
                                <strong>@item.Species?.Name</strong><br />
                                <em class="text-muted small">@item.Species?.LatinName</em>
                            </td>
                            <td>
                                @item.Latitude.ToString("F6"),<br />
                                @item.Longitude.ToString("F6")
                            </td>
                            <td>@(item.EstimatedAge.HasValue ? item.EstimatedAge.Value + " години" : "-")</td>
                            <td>@(item.Height.HasValue ? item.Height.Value.ToString("F2") + " м" : "-")</td>
                            <td>@(item.Condition ?? "-")</td>
                            <td>
                                <div class="btn-group" role="group">
                                    <a asp-controller="Trees" asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">
                                        <span>👁️</span> Виж
                                    </a>
                                    <a asp-action="EditTree" asp-route-id="@item.Id" class="btn btn-sm btn-warning">
                                        <span>✏️</span> Редактирай
                                    </a>
                                    <a asp-action="DeleteTree" asp-route-id="@item.Id" class="btn btn-sm btn-danger">
                                        <span>🗑️</span> Изтрий
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            Няма намерени дървета. <a asp-action="CreateTree" class="alert-link">Създайте първото дърво</a>
        </div>
    }
</div>
