@model LeafMap_Insights.Models.Family

@{
    ViewData["Title"] = "Изтриване на семейство";
}

<div class="container-fluid fade-in">
    <div class="page-header">
        <div>
            <h1><span>🗑️</span> Изтриване на семейство</h1>
            <p class="lead">Сигурни ли сте, че искате да изтриете това семейство?</p>
        </div>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    <div>
        <hr />
        <dl class="row">
            <dt class="col-sm-2">Име:</dt>
            <dd class="col-sm-10">@Model.Name</dd>

            <dt class="col-sm-2">Описание:</dt>
            <dd class="col-sm-10">@(Model.Description ?? "Н/Д")</dd>
        </dl>

        <form asp-action="DeleteFamily" class="mt-4">
            <input type="hidden" asp-for="Id" />
            <input type="submit" value="Изтрий" class="btn btn-danger btn-lg" />
            <a asp-action="Families" class="btn btn-secondary btn-lg">Отказ</a>
        </form>
    </div>
</div>
