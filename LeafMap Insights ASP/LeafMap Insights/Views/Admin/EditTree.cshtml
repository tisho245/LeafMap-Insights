@model LeafMap_Insights.Models.ViewModels.TreeViewModel

@{
    ViewData["Title"] = "Редактиране на дърво";
}

<div class="container-fluid fade-in">
    <div class="page-header">
        <div>
            <h1><span>✏️</span> Редактиране на дърво</h1>
            <p class="lead">Актуализиране на информация за дървото</p>
        </div>
    </div>
<div class="row">
    <div class="col-md-6">
        <form asp-action="EditTree">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            
            <div class="form-group mb-3">
                <label asp-for="SpeciesId" class="control-label"></label>
                <select asp-for="SpeciesId" class="form-control" asp-items="@(new SelectList(Model.AvailableSpecies ?? new List<LeafMap_Insights.Models.Species>(), "Id", "LatinName"))">
                    <option value="">-- Изберете вид --</option>
                </select>
                <span asp-validation-for="SpeciesId" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="form-group mb-3 col-md-6">
                    <label asp-for="Latitude" class="control-label"></label>
                    <input asp-for="Latitude" class="form-control" step="0.000001" />
                    <span asp-validation-for="Latitude" class="text-danger"></span>
                </div>

                <div class="form-group mb-3 col-md-6">
                    <label asp-for="Longitude" class="control-label"></label>
                    <input asp-for="Longitude" class="form-control" step="0.000001" />
                    <span asp-validation-for="Longitude" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group mb-3">
                <label asp-for="EstimatedAge" class="control-label"></label>
                <input asp-for="EstimatedAge" class="form-control" />
                <span asp-validation-for="EstimatedAge" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Height" class="control-label"></label>
                <input asp-for="Height" class="form-control" step="0.01" />
                <span asp-validation-for="Height" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Condition" class="control-label"></label>
                <input asp-for="Condition" class="form-control" />
                <span asp-validation-for="Condition" class="text-danger"></span>
            </div>

            <div class="form-group mt-4">
                <input type="submit" value="Запази промените" class="btn btn-primary btn-lg" />
                <a asp-action="Trees" class="btn btn-secondary btn-lg">Отказ</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
