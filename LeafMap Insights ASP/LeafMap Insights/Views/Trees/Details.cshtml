@model LeafMap_Insights.Models.Tree

@{
    ViewData["Title"] = "Детайли за дърво";
}

<div class="container-fluid fade-in">
    <div class="page-header">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h1><span>🌳</span> Детайли за дърво</h1>
                <p class="lead">@Model.Species?.Name - <em>@Model.Species?.LatinName</em></p>
            </div>
            @if (User.IsInRole("Admin"))
            {
                <a asp-controller="Admin" asp-action="EditTree" asp-route-id="@Model.Id" class="btn btn-light btn-lg">
                    <span>✏️</span> Редактирай дърво
                </a>
            }
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">

            <dl class="row">
                <dt class="col-sm-3">ID на дърво:</dt>
                <dd class="col-sm-9">@Model.Id</dd>

                <dt class="col-sm-3">Вид:</dt>
                <dd class="col-sm-9">
                    @Model.Species?.Name<br />
                    <em class="text-muted">@Model.Species?.LatinName</em>
                </dd>

                <dt class="col-sm-3">Род:</dt>
                <dd class="col-sm-9">
                    @Model.Species?.Genus?.Name<br />
                    <em class="text-muted">@Model.Species?.Genus?.LatinName</em>
                </dd>

                <dt class="col-sm-3">Семейство:</dt>
                <dd class="col-sm-9">@Model.Species?.Genus?.Family?.Name</dd>

                <dt class="col-sm-3">Местоположение:</dt>
                <dd class="col-sm-9">
                    Географска ширина: @Model.Latitude.ToString("F8")<br />
                    Географска дължина: @Model.Longitude.ToString("F8")
                </dd>

                <dt class="col-sm-3">Приблизителна възраст:</dt>
                <dd class="col-sm-9">@(Model.EstimatedAge.HasValue ? Model.EstimatedAge.Value + " години" : "Неизвестна")</dd>

                <dt class="col-sm-3">Височина:</dt>
                <dd class="col-sm-9">@(Model.Height.HasValue ? Model.Height.Value.ToString("F2") + " метра" : "Неизвестна")</dd>

                <dt class="col-sm-3">Състояние:</dt>
                <dd class="col-sm-9">@(Model.Condition ?? "Н/Д")</dd>

                @if (!string.IsNullOrEmpty(Model.Species?.Description))
                {
                    <dt class="col-sm-3">Описание:</dt>
                    <dd class="col-sm-9">@Model.Species.Description</dd>
                }
            </dl>

            <div class="mt-4">
                <a asp-action="Index" class="btn btn-secondary">
                    <span>←</span> Назад към списъка
                </a>
                <a asp-action="Map" class="btn btn-primary">
                    <span>🗺️</span> Виж на картата
                </a>
            </div>
        </div>

        <div class="col-md-4">
            <div class="qr-code-card shadow-custom">
                <h5 class="card-title mb-3">
                    <span>📱</span> QR Код
                </h5>
                @if (!string.IsNullOrEmpty(ViewBag.QRCodeBase64))
                {
                    <img src="data:image/png;base64,@ViewBag.QRCodeBase64" alt="QR Код" class="img-fluid mb-3" style="max-width: 250px;" />
                    <p class="text-muted mb-3">Сканирайте този QR код, за да видите това дърво на мобилното си устройство</p>
                    <a asp-action="QRCode" asp-route-id="@Model.Id" class="btn btn-outline-primary" download>
                        <span>⬇️</span> Изтегли QR код
                    </a>
                }
                else
                {
                    <p class="text-muted">QR кодът не е наличен</p>
                }
            </div>

            <div class="card mt-3">
                <div class="card-header">
                    <h5><span>📍</span> Местоположение</h5>
                </div>
                <div class="card-body">
                    <p class="mb-1"><strong>Географска ширина:</strong> @Model.Latitude.ToString("F8")</p>
                    <p class="mb-0"><strong>Географска дължина:</strong> @Model.Longitude.ToString("F8")</p>
                </div>
            </div>
        </div>
    </div>
</div>
