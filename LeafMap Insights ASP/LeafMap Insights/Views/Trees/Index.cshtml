@model IEnumerable<LeafMap_Insights.Models.Tree>

@{
    ViewData["Title"] = "Дървета";
}

<div class="container-fluid fade-in">
    <div class="page-header">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h1><span>🌲</span> Дървета</h1>
                <p class="lead">Разгледайте нашата колекция от дървета</p>
            </div>
            @if (User.IsInRole("Admin"))
            {
                <a asp-controller="Admin" asp-action="CreateTree" class="btn btn-light btn-lg">
                    <span>➕</span> Добави ново дърво
                </a>
            }
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Вид</th>
                        <th>Латинско име</th>
                        <th>Местоположение</th>
                        <th>Възраст</th>
                        <th>Височина</th>
                        <th>Състояние</th>
                        <th>Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td>@item.Species?.Name</td>
                            <td><em>@item.Species?.LatinName</em></td>
                            <td>@item.Latitude.ToString("F6"), @item.Longitude.ToString("F6")</td>
                            <td>@(item.EstimatedAge.HasValue ? item.EstimatedAge.Value + " години" : "Неизвестна")</td>
                            <td>@(item.Height.HasValue ? item.Height.Value.ToString("F2") + " м" : "Неизвестна")</td>
                            <td>@(item.Condition ?? "Н/Д")</td>
                            <td>
                                <div class="btn-group" role="group">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">
                                        <span>👁️</span> Виж
                                    </a>
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <a asp-controller="Admin" asp-action="EditTree" asp-route-id="@item.Id" class="btn btn-sm btn-warning">
                                            <span>✏️</span> Редактирай
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info" role="alert">
            В базата данни няма намерени дървета.
            @if (User.IsInRole("Admin"))
            {
                <a asp-controller="Admin" asp-action="CreateTree" class="alert-link">Добавете първото дърво</a>
            }
        </div>
    }
</div>
