@model List<ASPLeafMapInsightsWebMVC.ViewModels.TreeVm>
@{
    ViewData["Title"] = "Карта";
}
<h2>Дървета на карта</h2>
<p>Дървета с координати (от API):</p>
<ul class="list-group">
    @foreach (var t in Model)
    {
        <li class="list-group-item">
            <strong>@t.Name</strong> — @t.Latitude.ToString("F4"), @t.Longitude.ToString("F4")
        </li>
    }
</ul>
@if (!Model.Any())
{
    <p class="text-muted">Няма дървета. Стартирайте API-то със seed данни.</p>
}
<p class="mt-3 small text-muted">За интерактивна карта (Leaflet/OpenStreetMap) може да се добави по-късно; данните вече идват от API.</p>
